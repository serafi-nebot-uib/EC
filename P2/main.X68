	ORG $1000

NINSTR:	EQU	16
INSTR:
	DC.W %0000000000000000
	DC.W %0001000000000000
	DC.W %0010000000000000
	DC.W %0011000000000000
	DC.W %0100000000000000
	DC.W %0101000000000000
	DC.W %0110000000000000
	DC.W %1000000000000000
	DC.W %1100000000000000
	DC.W %1100100000000000
	DC.W %1101000000000000
	DC.W %1101100000000000
	DC.W %1110000000000000
	DC.W %1110100000000000
	DC.W %1111000000000000
INSTR_OUT:
	DS.B NINSTR
	DS.W 0

START:
	MOVE.L #NINSTR-1, D0
DEC_LP:
	MOVE.L D0, D1
	MULU #2, D1
	MOVEA.L D1, A0
	MOVE.W INSTR(A0), -(A7)
	JSR OP_DEC
	MOVE.W (A7)+, D1
	MOVEA.L D0, A0
	MOVE.B D1, INSTR_OUT(A0)
	DBRA D0, DEC_LP

	TRAP #15

OP_DEC:
	MOVE.L D0, -(A7)
	MOVE.W 8(A7), D0
	BTST #15, D0
	BNE OP_ONE
	LSR.W #8, D0
	LSR.W #4, D0
	JMP END
OP_ONE:
	LSR.W #8, D0
	LSR.W #3, D0
	BTST #3, D0
	BEQ OP_EXIT
	ANDI #%01111, D0
	JMP END
OP_EXIT:
	MOVEQ #7, D0
	JMP END
END:
	MOVE.W D0, 8(A7)
	MOVE.L (A7)+, D0
	RTS

	END START
