	ORG $1000

NINSTR:	EQU	16
INSTR:
	DC.W %0000000000000000
	DC.W %0001000000000000
	DC.W %0010000000000000
	DC.W %0011000000000000
	DC.W %0100000000000000
	DC.W %0101000000000000
	DC.W %0110000000000000
	DC.W %1000000000000000
	DC.W %1100000000000000
	DC.W %1100100000000000
	DC.W %1101000000000000
	DC.W %1101100000000000
	DC.W %1110000000000000
	DC.W %1110100000000000
	DC.W %1111000000000000
INSTR_OUT:
	DS.B NINSTR
	DS.W 0

START:
	MOVE.L #NINSTR-1, D0
DEC_LP:
	MOVE.L D0, D1
	MULU #2, D1
	MOVEA.L D1, A0
	MOVE.W INSTR(A0), -(SP)
	JSR OP_DEC
	MOVE.W (SP)+, D1
	MOVEA.L D0, A0
	MOVE.B D1, INSTR_OUT(A0)
	DBRA D0, DEC_LP

	TRAP #15

OP_DEC:
	MOVE.L D0, -(SP)
	MOVE.W 8(SP), D0
	BTST #15, D0
	BEQ.S *+12
	LSL.W #1, D0
	BTST #15, D0
	BNE.S *+4
	MOVE.W #%0111000000000000, D0
OP_END:
	LSR.W #8, D0
	LSR.W #4, D0
	MOVE.W D0, 8(SP)
	MOVE.L (SP)+, D0
	RTS

	END START
