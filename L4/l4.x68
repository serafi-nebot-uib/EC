	ORG $1000

N:	EQU 7
V:	DC.B -10,120,8,70,0,-99,-106
C:	DC.B 0
T1:	EQU 8
T2:	EQU 99

START:
	MOVEQ #N-1, D0
	CLR D1
	LEA.L V, A0

LOOP:
	MOVE.B (A0)+, D2
	CMP.B #0, D2
	BGE COMPARE
	NEG.B D2

COMPARE:
	CMP.B #T1, D2
	BLT NIR
	CMP.B #T2, D2
	BGT NIR
	ADDQ.B #1, D1

NIR:
	DBRA D0, LOOP

	MOVE.L D1, C

	SIMHALT

	END START
